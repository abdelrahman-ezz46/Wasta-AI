{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wasta-devhost",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Wasta.DevHost/Wasta.DevHost.csproj", "--urls", "http://localhost:5219"],
      "port": 5219
    },
    {
      "name": "wasta-streamlit",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "streamlit", "run", "streamlit/app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
