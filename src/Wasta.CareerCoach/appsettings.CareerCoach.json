{
  "_comment": "Merge this into your host app's appsettings.json. ApiKey values must come from environment/user-secrets, never committed as literals. The Ai section is shared with Wasta.SupportChat - merge it once, not per feature.",
  "Ai": {
    "Enabled": true,
    "TimeoutSeconds": 30,
    "MaxTokens": 1600,
    "Temperature": 0.4,
    "Chain": ["groq", "gemini"],
    "Providers": {
      "groq": {
        "BaseUrl": "https://api.groq.com/openai/v1/chat/completions",
        "Model": "<pick a current model from console.groq.com>",
        "ApiKey": ""
      },
      "gemini": {
        "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/models",
        "Model": "<pick a current model from ai.google.dev>",
        "ApiKey": ""
      }
    }
  },
  "CareerCoach": {
    "PromptPath": "Prompts/CareerCoach.v1.txt"
  }
}
