# Copy to .env and fill in real values. NEVER commit the filled-in .env.
# .env is gitignored; .env.example (this file, placeholders only) is committed.
#
# Safer alternative for local dev - keeps secrets out of the repo entirely:
#   dotnet user-secrets set "Ai:Providers:groq:ApiKey" "<your-key>"

# --- AI providers (at least one required for the features to do anything) ---
# Groq: https://console.groq.com
AI__PROVIDERS__GROQ__APIKEY=
AI__PROVIDERS__GROQ__MODEL=

# Gemini: https://ai.google.dev
AI__PROVIDERS__GEMINI__APIKEY=
AI__PROVIDERS__GEMINI__MODEL=

# --- Database ---
CONNECTIONSTRINGS__WASTA=Host=localhost;Database=wasta;Username=postgres;Password=

# --- Feature kill switch ---
AI__ENABLED=true
